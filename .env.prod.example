# Copy this file to .env.prod and fill in real values before deploying.
# Never commit the actual .env.prod file.
#
# Used both by `docker compose --env-file .env.prod` (for ${VAR}
# substitution inside docker-compose.prod.yml) and passed into the backend
# container via `env_file`. See docs/DEPLOYMENT.md.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Only turn these on once a reverse proxy/load balancer in front of this
# container actually terminates HTTPS and forwards X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

DJANGO_DB_CONN_MAX_AGE=60
GUNICORN_WORKERS=3

# --- PostgreSQL ---
POSTGRES_DB=graduation
POSTGRES_USER=graduation
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (the deployed frontend origin) ---
CORS_ALLOWED_ORIGINS=https://example.com

# --- Frontend build (baked in at image build time, see frontend/Dockerfile.prod) ---
VITE_API_BASE_URL=https://api.example.com/api
